# Copy to .env and fill in locally. NEVER commit .env.

# NASA API key (https://api.nasa.gov) — DEMO_KEY works with low rate limits
NASA_API_KEY=DEMO_KEY

# Earthdata Login (https://urs.earthdata.nasa.gov) — required for some downloads (LP DAAC, NSIDC, GES DISC)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Field Shift SQLite database (generated, git-ignored). Default: data/processed/fieldshift.db
FIELDSHIFT_DB=

# Hosted demo (Dockerfile, decision 0008) — set in the image / by Cloud Run, not needed locally:
#   PORT=8080                       port the container listens on (Cloud Run sets it); locally the API stays on 8000
#   FIELDSHIFT_DB=/tmp/fieldshift.db  writable path; the DB is rebuilt from the committed seeds at every start
# Deploy: no secrets needed by the app. Google Cloud access stays in each deployer's own gcloud login, NEVER in this file.
