# Copy to .env and fill in locally. NEVER commit .env.

# NASA API key (https://api.nasa.gov) — DEMO_KEY works with low rate limits
NASA_API_KEY=DEMO_KEY

# Earthdata Login (https://urs.earthdata.nasa.gov) — required for some downloads (LP DAAC, NSIDC, GES DISC)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Field Shift SQLite database (generated, git-ignored). Default: data/processed/fieldshift.db
FIELDSHIFT_DB=

# Hosted demo (Dockerfile, decision 0006) — set in the image, not needed locally:
#   PORT=7860                       port the container listens on (Hugging Face Spaces default); locally the API stays on 8000
#   FIELDSHIFT_DB=/tmp/fieldshift.db  writable path; the DB is rebuilt from the committed seeds at every start
# Deploy workflow (.github/workflows/deploy-space.yml) — GitHub repo settings, NEVER in this file:
#   Actions secret HF_TOKEN  (Hugging Face fine-grained token, write access to the Space only)
#   Actions variable HF_SPACE (<hf-user>/<space-name>)
