# Secrets
.env
.env.*
!.env.example
*.pem
*.key
.netrc
_netrc

# Data (large files never in git; keep small samples in data/samples)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.nc
*.nc4
*.h5
*.hdf
*.he5
*.tif
*.tiff
*.zarr/

# Generated SQLite database (schema + seed are committed, the .db file is built at startup)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Node
node_modules/
dist/
build/
.next/
.vite/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code local-only settings
.claude/settings.local.json

# Taste skill runtime state (screenshots, caches; see docs/ui-skills.md)
.taste-skill/

# Organizer event material (not ours to redistribute)
event-material/
